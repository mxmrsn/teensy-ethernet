<?xml version="1.0"?>
<package format="3">
  <name>teensy_bench</name>
  <version>0.1.0</version>
  <description>C++ benchmark nodes for the Teensy micro-ROS link: rate meter + RTT ping.</description>
  <maintainer email="max.emerson@sciton.com">max</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>teensy_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
